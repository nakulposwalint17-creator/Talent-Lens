# TalentLens backend configuration. Copy to backend/.env and adjust.
# Never commit a real .env file.

# development (default) | production. Production disables /docs, sends HSTS and
# refuses unsafe settings (wildcard CORS) at startup.
ENVIRONMENT=development

# --- Authentication -------------------------------------------------------
# Every endpoint except /api/health requires sign-in. The first administrator is
# created from these on startup if it doesn't exist (an existing account is never
# changed). Use 12+ characters. ./scripts/setup.sh fills these in with a random password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Lifetime of a sign-in session.
AUTH_TOKEN_TTL_HOURS=12

# --- Rate limiting (in-memory, per process) -------------------------------
RATE_LIMIT_ENABLED=true
# All /api requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=300
# Uploads, criteria extraction and evaluation runs per user per minute.
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
# Within 15 minutes: sign-in attempts per IP, and failed sign-ins before an account is locked.
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_FAILURES_PER_ACCOUNT=5
# Reverse proxies in front of the API that append X-Forwarded-For (0 locally, 1 on Render).
TRUSTED_PROXY_HOPS=0

# "demo" (default): rule-based evaluation, no external calls, no API key needed.
# "anthropic": live AI evaluation via the Anthropic API (requires a separate API
# key and API billing; a Claude subscription does not include API credits).
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT_SECONDS=90
ANTHROPIC_MAX_ATTEMPTS=3
# Server-side refusal fallbacks (beta) for supported models.
ANTHROPIC_SERVER_FALLBACKS=true

# Storage: SQLite database lives in DATA_DIR (relative paths resolve from backend/).
DATA_DIR=data
# Optional: use Postgres instead of SQLite (postgres:// and postgresql:// URLs both work).
# DATABASE_URL=postgresql://user:password@host:5432/talentlens
# DATABASE_URL=sqlite:////absolute/path/to/talentlens.db

# Upload limits
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=25
MAX_PDF_PAGES=30

# Near-duplicate threshold (word 3-shingle Jaccard similarity, 0–1). An initial
# hypothesis tuned on the synthetic samples, not a validated value.
NEAR_DUPLICATE_THRESHOLD=0.80

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
