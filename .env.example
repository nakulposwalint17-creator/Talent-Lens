# TalentLens configuration overview. The application reads:
#   backend/.env        (copy of backend/.env.example)
#   frontend/.env.local (copy of frontend/.env.example)
# ./scripts/setup.sh creates both. Placeholders only — never commit real keys.

# --- backend/.env ---
ENVIRONMENT=development          # production: no /docs, HSTS, strict checks
ADMIN_EMAIL=                     # first administrator, created on startup
ADMIN_PASSWORD=                  # 12+ characters; setup.sh generates one
TRUSTED_PROXY_HOPS=0             # 1 behind Render's proxy
AI_PROVIDER=demo                 # demo | anthropic
ANTHROPIC_API_KEY=               # only for live mode; requires separate Anthropic API billing
ANTHROPIC_MODEL=claude-opus-5-5
DATA_DIR=data
MAX_UPLOAD_MB=10
NEAR_DUPLICATE_THRESHOLD=0.80
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- frontend/.env.local ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
